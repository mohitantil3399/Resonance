<Window x:Class="WindowsAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Sync Agent" Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="White">

    <Window.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="⚡" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Local Sync Agent" FontSize="22" FontWeight="Bold" Foreground="#CDD6F4"/>
                <TextBlock Text="Windows ↔ Android" FontSize="12" Foreground="#6C7086"/>
            </StackPanel>
        </StackPanel>

        <!-- Connection Status -->
        <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="#F38BA8"/>
                    <TextBlock x:Name="StatusText" Text="Waiting for hotspot..." 
                               FontSize="14" Foreground="#BAC2DE" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="DetailText" Text="Connect to your phone's hotspot to begin" 
                           FontSize="11" Foreground="#585B70" Margin="18,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Section Header -->
        <TextBlock Grid.Row="2" Text="📋 Clipboard Journal (last 10)" 
                   FontSize="14" Foreground="#A6ADC8" Margin="0,0,0,8"/>

        <!-- Clipboard History List -->
        <Border Grid.Row="3" Background="#313244" CornerRadius="8" Padding="4">
            <ListBox x:Name="ClipboardList" Background="Transparent" BorderThickness="0"
                     Foreground="#CDD6F4" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#45475A" CornerRadius="6" Padding="10,8" Margin="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" 
                                           MaxHeight="40" Foreground="#CDD6F4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#89B4FA"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding TimeDisplay}" FontSize="10" Foreground="#585B70"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4" x:Name="FooterText" Text="Scanning for Android agent on port 7777..." 
                   FontSize="10" Foreground="#45475A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>
